conky.config = {
    -- General
    background = true,
    update_interval = 2,
    cpu_avg_samples = 4,
    diskio_avg_samples = 10,
    net_avg_samples = 2,
    no_buffers = true,
    text_buffer_size = 8192,
    temperature_unit = 'celsius',
    imlib_cache_size = 0,
    
    -- Placement
    alignment = 'bottom_left',
    gap_x = 365,
    gap_y = 356,
    minimum_height = 190,
    maximum_height = 190,
    minimum_width = 300,
    maximum_width = 300,
    xinerama_head = 2,
    
    -- Graphical
    border_inner_margin = 10,
    border_outer_margin = 5,
    border_width = 0,
    default_bar_width = 80,
    default_bar_height = 10,
    default_gauge_height = 25,
    default_gauge_width = 40,
    default_graph_height = 40,
    default_graph_width = 0,
    draw_borders = false,
    draw_graph_borders = true,
    default_graph_colour = '#a7c080',
    draw_shades = false,
    draw_outline = false,
    
    -- Text
    extra_newline = false,
    format_human_readable = true,
    font = 'Roboto:size=10',
    max_user_text = 16384,
    override_utf8_locale = true,
    short_units = true,
    use_spacer = 'none',
    use_xft = true,
    xftalpha = 1,
    
    -- Window
    own_window = true,
    own_window_type = 'normal',
    double_buffer = true,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_title = 'twitch_conky',
    own_window_colour = '#1a1e1e2e',

    -- Colors (Everforest Dark)
    default_color = '#d3c6aa',
    color1 = '#e67e80',
    color2 = '#7fbbb3',
    color3 = '#d3c6aa',
    color4 = '#dbbc7f',
    color5 = '#a7c080',
    color6 = '#d3c6aa',
    color7 = '#a7c080',
    color8 = '#dbbc7f',
    color9 = '#e67e80',
};

conky.text = [[
${color5}Twitch Chat: ${color}${exec cat $HOME/.config/conky/twitch_chat/config.txt}
${color}${hr 2}
${color}${execi 2 cat $HOME/.config/conky/twitch_chat/chat.txt 2>/dev/null || echo "Chat not connected"}
]]
