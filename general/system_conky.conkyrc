conky.config = {
    -- General
    background = true,
    update_interval = 2,
    cpu_avg_samples = 4,
    diskio_avg_samples = 10,
    net_avg_samples = 2,
    double_buffer = true,
    no_buffers = true,
    text_buffer_size = 2048,
    temperature_unit = 'celsius',
    imlib_cache_size = 0,
    
    -- Placement
    alignment = 'top_left',
    gap_x = 25,
    gap_y = 130,
    minimum_height = 300,
    maximum_height = 300,
    minimum_width = 300,
    maximum_width = 300,
    xinerama_head = 2,
    
    -- Graphical
    border_inner_margin = 10,
    border_outer_margin = 5,
    border_width = 0,
    default_bar_width = 80,
    default_bar_height = 10,
    default_gauge_height = 25,
    default_gauge_width = 40,
    default_graph_height = 40,
    default_graph_width = 0,
    draw_borders = false,
    draw_graph_borders = true,
    default_graph_colour = '#a7c080',
    draw_shades = false,
    draw_outline = false,
    
    -- Text
    extra_newline = false,
    format_human_readable = true,
    font = 'Roboto:size=10',
    max_user_text = 16384,
    override_utf8_locale = true,
    short_units = true,
    use_spacer = 'none',
    use_xft = true,
    xftalpha = 1,
    
    -- Window
    own_window = true,
    own_window_type = 'normal',
    double_buffer = true,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_title = 'system_conky',
    own_window_colour = '#1a1e1e2e',

    -- Colors (Everforest Dark)
    default_color = '#d3c6aa',
    color1 = '#e67e80',
    color2 = '#7fbbb3',
    color3 = '#d3c6aa',
    color4 = '#dbbc7f',
    color5 = '#a7c080',
    color6 = '#d3c6aa',
    color7 = '#a7c080',
    color8 = '#dbbc7f',
    color9 = '#e67e80',
};

local mount_storage = os.getenv("MOUNT_STORAGE_PATH") or "/mnt/storage"
local mount_os2 = os.getenv("MOUNT_OS2_PATH") or "/mnt/os2"

conky.text = ([[
${font Roboto:style=Bold:size=10}${color5}${execi 60 nvidia-smi --query-gpu=name --format=csv,noheader}${font}
${offset 10}${color6}GPU Temp: ${alignr}${execi 10 nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader} °C
${offset 10}Fan Speed: ${alignr}${execi 10 nvidia-smi --query-gpu=fan.speed --format=csv,noheader,nounits} %
${offset 10}GPU Clock: ${alignr}${execi 10 nvidia-smi --query-gpu=clocks.current.graphics --format=csv,noheader,nounits} MHz
${offset 10}Mem Clock: ${alignr}${execi 10 nvidia-smi --query-gpu=clocks.current.memory --format=csv,noheader,nounits} MHz
${offset 10}Mem Used: ${alignr}${execi 60 nvidia-settings -q [gpu:0]/UsedDedicatedGPUMemory -t} / ${exec nvidia-settings -q [gpu:0]/TotalDedicatedGPUMemory -t} MiB
${offset 10}Mem History: ${alignr}${execgraph "nvidia-smi --id=0 --query-gpu=memory.used,memory.total --format=csv,noheader,nounits | awk -F',' '{u=$1+0; t=$2+0; if (t > 0) print int((u/t)*100); else print 0}'" 8,90 a7c080 7fbbb3}
${offset 10}Power Limit: ${alignr}${execi 10 nvidia-smi --query-gpu=power.limit --format=csv,noheader,nounits} W
${color5}${font Roboto:size=10}P R O C E S S O R S  ${hr 1}${font}${color}
${color5}CPU Freq:${color} ${alignr}${freq} MHz
${color5}CPU Usage & Temps:${color} ${hwmon 0 temp 1}°C
${offset 10}Core 0:  ${hwmon 1 temp 1}°C ${alignr}${cpu cpu0}% ${cpubar cpu0 6,60}
${offset 10}Core 1:  ${hwmon 2 temp 1}°C ${alignr}${cpu cpu1}% ${cpubar cpu1 6,60}
${offset 10}Core 2:  ${hwmon 3 temp 1}°C ${alignr}${cpu cpu2}% ${cpubar cpu2 6,60}
${offset 10}Core 3:  ${hwmon 4 temp 1}°C ${alignr}${cpu cpu3}% ${cpubar cpu3 6,60}
${color5}History:${color} ${alignr}${cpugraph 8,50 a7c080 7fbbb3}
${color5}Top Processes${goto 222}cpu%${goto 274}mem%${color}
${offset 10}1 - ${top name 1}${alignr}${goto 222}${top cpu 1} ${goto 274}${top mem 1}
${offset 10}2 - ${top name 2}${alignr}${goto 222}${top cpu 2} ${goto 274}${top mem 2}
${offset 10}3 - ${top name 3}${alignr}${goto 222}${top cpu 3} ${goto 274}${top mem 3}
${color5}${font Roboto:size=10}M E M O R Y   ${hr 2}${font}${color}
${offset 10}RAM: ${alignr}${mem} / ${memmax} ${alignr}${membar}
${offset 10}Swap: ${alignr}${swap} / ${swapmax} ${alignr}${swapbar}
${color5}Top Processes${goto 222}cpu%${goto 274}mem%${color}
${offset 10}1 - ${top_mem name 1}${alignr}${goto 170} ${goto 222}${top_mem cpu 1} ${goto 274}${top_mem mem 1}
${offset 10}2 - ${top_mem name 2}${alignr}${goto 170} ${goto 222}${top_mem cpu 2} ${goto 274}${top_mem mem 2}
${offset 10}3 - ${top_mem name 3}${alignr}${goto 170} ${goto 222}${top_mem cpu 3} ${goto 274}${top_mem mem 3}
${color5}${font Roboto:size=10}D R I V E S   ${hr 2}${font}${color}
${offset 10}arch_ssd1: ${alignr}${fs_used /} / ${fs_size /} ${alignr}${fs_bar /}
${offset 20}I/O Read: ${diskio_read /dev/sdb2} ${diskiograph_read sdb2 8,50 a7c080 7fbbb3} ${alignr}Write: ${diskio_write /dev/sdb2} ${alignr}${diskiograph_write sdb2 8,50 a7c080 7fbbb3}
${offset 10}Storage: ${alignr}${fs_used __MOUNT_STORAGE__} / ${fs_size __MOUNT_STORAGE__} ${alignr}${fs_bar __MOUNT_STORAGE__}
${offset 20}I/O Read: ${diskio_read /dev/sda1} ${diskiograph_read sda1 8,50 a7c080 7fbbb3} ${alignr}Write: ${diskio_write /dev/sda1} ${alignr}${diskiograph_write sda1 8,50 a7c080 7fbbb3}
${offset 10}OS Drive: ${alignr}${fs_used __MOUNT_OS2__} / ${fs_size __MOUNT_OS2__} ${alignr}${fs_bar __MOUNT_OS2__}
${offset 20}I/O Read: ${diskio_read /dev/sdc2} ${diskiograph_read sdc2 8,50 a7c080 7fbbb3} ${alignr}Write: ${diskio_write /dev/sdc2} ${alignr}${diskiograph_write sdc2 8,50 a7c080 7fbbb3}
${color5}${font Roboto:size=10}N E T W O R K   ${hr 1}${font}${color}
${offset 10}IP: ${alignr}${addrs enp2s0}
${offset 10}Public IP: ${alignr}${execi 300 curl -4 -s ifconfig.me}
${offset 10}Up: ${alignr}${upspeed enp2s0} ${alignr}${upspeedgraph enp2s0 8,50 a7c080 7fbbb3}
${offset 10}Down: ${alignr}${downspeed enp2s0} ${alignr}${downspeedgraph enp2s0 8,50 a7c080 7fbbb3}
]]):gsub("__MOUNT_STORAGE__", mount_storage):gsub("__MOUNT_OS2__", mount_os2);
